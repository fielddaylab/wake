# basePath interior.job.bayou

#include "Headers/Common.leaf"

#const JobGiverId = profBayou
#const JobGiverCameraPose = "JobGiverCameraPose"

#include "Headers/CommonJob.leaf"

// Generic

#NoJobHandler(a)
{@$JobGiverId}  Hey, want to see the {h}Job Board{/h}?
$choice .action.openJobBoard; Sure!
$choice .action.cancel; No thanks.

#NoJobHandler(mentionTio, jobs:final-final.upgradeReady, !jobs:final-final.tio.code-received)
{@$JobGiverId}  Ollie, I received a call from the {nameof RS-1C}. {nameof kelpMechanic} has something urgent to discuss.
                You shouldn't leave him waiting too long.
                I'll let you think about it. Want to see the {h}Job Board{/h}?
$choice .action.openJobBoard; Sure!
$choice .action.cancel; No thanks.

#WrongStationJobHandler(a)
{@$JobGiverId}  Hmm, it looks like you've taken a job with someone else.
                Unfortunately I can't help you with it here.
                No shame in switching jobs to something here though.
                Still want to see the {h}Job Board{/h}?
    $choice .action.openJobBoard; Yes.
    $choice .action.cancel; Nah.

#WrongStationJobHandler(b)
{@$JobGiverId}  I think you have a job with someone else right now.
                You'll have to talk to them for the details.
                Could always take a job here though...
                Still want to see the {h}Job Board{/h}?
    $choice .action.openJobBoard; Yes.
    $choice .action.cancel; Nah.

#WrongCharacterJobHandler(a)
{@$JobGiverId}  You seem to have a job with {nameof @bayouSci}...
                You should talk to him instead.

#WrongCharacterJobHandler(b)
{@$JobGiverId}  Ah, I believe you need to talk to {nameof @bayouSci} instead.
                He's the one for your current job.

#JobHandler(a)
{@$JobGiverId}  {random Hey, got|So, do you have} anything to report for your current job?
    $choice .action.report; Yep!
    $choice .action.openJobBoard; Let me {random see|look at} the {h}Job Board{/h}.
    $choice .action.cancel.currentJob; Nope.

:: action.cancel
@cutscene
{@$JobGiverId}  Okay, well please let me know when you need me.

:: action.cancel.currentJob
@cutscene
{@$JobGiverId}  Just let me know when you're ready then.

// Recommendations

#JobRecommendationHandler(noJob1, !jobId)
@boostScore 5000
@repeat 1
{@$JobGiverId}  Hmm, I'm not sure you're ready for that yet.
                You |might| want to try some other jobs first.

#JobRecommendationHandler(noJob2, !jobId)
@boostScore 5000
@repeat 1
{@$JobGiverId}  I don't know if you're ready for that one yet, Ollie.
                I'd suggest you try some other jobs first.

#JobRecommendationHandler(jobWithMe1, jobPoster == "$JobGiverId", !jobInProgress)
@repeat 1
{@$JobGiverId}  I don't think I'd recommend this one just yet, Ollie.
                But I do have {nameof $local:jobId}.
                I'd suggest you give that one a look.

#JobRecommendationHandler(jobWithMe2, jobPoster == "$JobGiverId", !jobInProgress)
@repeat 1
{@$JobGiverId}  Hmm, I'm not sure you're ready for that one yet.
                I do have {nameof $local:jobId} posted.
                I'd recommend you check that job out first.

#JobRecommendationHandler(resumeJobWithMe1, jobPoster == "$JobGiverId", jobInProgress)
@repeat 1
{@$JobGiverId}  I don't think I'd recommend this one just yet, Ollie.
                But I believe you've already started on {nameof $local:jobId}.
                I'd suggest you give that one another look.

#JobRecommendationHandler(resumeJobWithMe2, jobPoster == "$JobGiverId", jobInProgress)
@repeat 1
{@$JobGiverId}  Hmm, I'm not sure you're ready for that one yet.
                But you've already started {nameof $local:jobId}.
                Perhaps you should go back and finish it.

#JobRecommendationHandler(jobWithOther1, jobPoster == "bayouSci")
@repeat 1
{@$JobGiverId}  I don't think I'd recommend this one just yet, Ollie.
                But {nameof @bayouSci} does have {nameof $local:jobId}.
                I'd suggest you give that one a look.

#JobRecommendationHandler(jobWithOther2, jobPoster == "bayouSci")
@repeat 1
{@$JobGiverId}  Hmm, I'm not sure you're ready for that one yet.
                {nameof @bayouSci} does have {nameof $local:jobId} posted.
                I'd recommend you check that job out first.

#JobRecommendationHandler(jobAtNotVisitedStation1, jobLocation != "BayouStation")
@repeat 1
{@$JobGiverId}  I can't recommend this one for you yet, Ollie.
                I know that {nameof $local:jobPoster} has a job over at the {nameof $local:jobLocation}.
                {nameof $local:jobId}, I believe it's called.

#JobRecommendationHandler(jobAtNotVisitedStation2, jobLocation != "BayouStation")
@repeat 1
{@$JobGiverId}  Hmm, I wouldn't suggest you try this one yet.
                But I know {nameof $local:jobPoster} has a job at the {nameof $local:jobLocation}.
                I'd recommend you head there and give {nameof $local:jobId} a try.